{
  "baseline": "4ef86df",
  "scope": "Core Komga HTTP protocols supported by komga-rs",
  "methodProbe": "TRACE requests must expose the declared methods through the Allow header; Kobo routes use functional tests because their ANY fallback consumes unmatched methods.",
  "mediaTypes": {
    "rest": [
      "application/json",
      "multipart/form-data",
      "application/octet-stream",
      "image/jpeg",
      "text/css",
      "font/*",
      "EPUB resource media types"
    ],
    "oauth": [
      "application/json",
      "text/html redirects"
    ],
    "sse": [
      "text/event-stream"
    ],
    "opds-v1": [
      "application/atom+xml",
      "application/xml",
      "text/xml",
      "publication resource media types"
    ],
    "opds-v2": [
      "application/opds+json",
      "application/opds-authentication+json",
      "application/webpub+json",
      "publication resource media types"
    ],
    "koreader": [
      "application/json",
      "application/vnd.koreader.v1+json"
    ],
    "kobo": [
      "application/json; charset=utf-8",
      "application/epub+zip",
      "image/jpeg"
    ]
  },
  "searchContract": {
    "entities": [
      "Book",
      "Series",
      "Collection",
      "ReadList"
    ],
    "fields": [
      "title",
      "name",
      "isbn",
      "tag",
      "series_tag",
      "book_tag",
      "author",
      "release_date",
      "status",
      "deleted",
      "oneshot",
      "publisher",
      "reading_direction",
      "age_rating",
      "language",
      "genre",
      "sharing_label",
      "total_book_count",
      "book_count",
      "complete",
      "dynamic author role"
    ],
    "syntax": [
      "default AND terms",
      "quoted phrases",
      "named fields",
      "dynamic author roles",
      "inclusive ranges",
      "boolean grouping and negation",
      "punctuation and hyphenated text",
      "CJK"
    ],
    "invalidQuery": "empty results",
    "resultLimit": 1000,
    "index": "Tantivy v2 rebuilt from SQLite",
    "exclusion": "Kotlin Lucene file-format interoperability"
  },
  "exclusions": [
    {
      "paths": [
        "/actuator/*"
      ],
      "except": [
        "/actuator/health",
        "/actuator/info",
        "/actuator/logfile",
        "/actuator/metrics",
        "/actuator/metrics/{metric}",
        "/actuator/shutdown"
      ],
      "reason": "JVM and Spring management endpoints are outside the compatibility target."
    },
    {
      "paths": [
        "/v3/api-docs",
        "/swagger-ui",
        "/swagger-ui/*"
      ],
      "reason": "Springdoc and Swagger UI are outside the compatibility target."
    },
    {
      "paths": [
        "/",
        "/index.html",
        "WebUI assets and SPA history fallback"
      ],
      "reason": "The WebUI is tested separately and is not part of the API manifest."
    }
  ],
